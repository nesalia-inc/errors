// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`SEO snapshots > llms.txt (first 4 KB + total length assertion) 1`] = `
"# Index

- [Getting Started](/docs/index)
- [Error Factory](/docs/error-factory)
- [API Reference](/docs/api-reference)
"
`;

exports[`SEO snapshots > llms-full.txt (length assertion + head snapshot) 1`] = `
"# Getting Started (/docs/index)

# Getting Started

Get started with @deessejs/errors.

# Error Factory (/docs/error-factory)

# Error Factory

Create custom error types with the error() function.

# API Reference (/docs/api-reference)

# API Reference

Complete API reference for all exports from @deessejs/errors."
`;

exports[`SEO snapshots > robots.txt 1`] = `
"User-agent: *
Allow: /
Disallow: /api/
Disallow: /llms.txt
Disallow: /llms.mdx/
Sitemap: https://errors.deessejs.com/sitemap.xml
"
`;

